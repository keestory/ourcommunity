{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm --prefix web ci && npm --prefix web run build",
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "includeFiles": "web/dist/**",
      "excludeFiles": "{web/node_modules/**,tests/**,.harness/**,.venv/**,docs/**}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "regions": [
    "icn1"
  ]
}
